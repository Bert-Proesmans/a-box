{
  "mcpServers": {
    "obsidian": {
      "type": "stdio",
      "command": "obsidian-mcp",
      "args": ["${CLAUDE_PROJECT_DIR:-.}"],
      "alwaysLoad": false,
      "env": {
        "OBSIDIAN_EMBEDDINGS": "true",
        "OBSIDIAN_EMBEDDING_PROVIDER": "local",
        "OBSIDIAN_TOOLS": "full",
        "OBSIDIAN_EXCLUDE_PATHS": ".claude/**,AGENTS.md,archive/**"
      }
    }
  }
}
